rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only your account counts as the owner of the recipe archive.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'ZNBtkJeO8DQwj9GoNCZgeQRT7Cc2';
    }

    // Recipes: anyone can read, only you can create, edit, or delete.
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Logs: each signed-in user can read and write only their own.
    match /users/{userId}/logs/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default.
  }
}